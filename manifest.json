{
  "manifest_version": 3,
  "name": "Facebook Tweaks",
  "version": "0.1.0",
  "description": "Choose UI adjustments for Facebook.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "action": {
    "default_title": "Facebook Tweaks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
